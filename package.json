{
  "name": "AuctionHouse",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch backend/main.ts",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build": "npm run check && npm run build:frontend && npm run build:backend",
    "start": "node dist/backend/main.js",
    "start:frontend": "npx vite preview --port 4173",
    "test": "vitest run tests/domain",
    "test:coverage": "vitest run tests/domain --coverage",
    "check:frontend": "tsc --noEmit -p tsconfig.json",
    "check:backend": "tsc --noEmit -p tsconfig.backend.json",
    "check": "npm run check:frontend && npm run check:backend",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx backend/src/infrastructure/database/seed.ts",
    "db:create:test": "node --env-file=.env.test --import tsx backend/src/infrastructure/database/criarBancoTeste.ts",
    "db:migrate:test": "node --env-file=.env.test ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:prepare:test": "npm run db:create:test && npm run db:migrate:test",
    "test:integration": "npm run db:prepare:test && node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/integration --no-file-parallelism",
    "db:reset": "tsx backend/src/infrastructure/database/reset.ts && npm run db:seed"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bootstrap": "^5.3.8",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
